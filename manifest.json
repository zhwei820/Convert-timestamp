{
  "manifest_version": 3,
  "name": "时间戳转化",
  "version": "1.1.0",
  "description": "时间戳与日期双向转换工具，支持弹窗输入、选中文字右键菜单转换、自动复制结果，内置 GitLab Pipeline 状态监控与 Gmail 新邮件通知",
  "action": {
    "default_popup": "src/popup.html"
  },
  "permissions": [
    "clipboardWrite",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/gitlab-pipeline-monitor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/text-preview-core.js",
        "src/raw-html-preview.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": [
        "src/gmail-new-mail-monitor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://files.slack.com/*",
        "https://slack-files.com/*"
      ],
      "js": [
        "src/text-preview-core.js",
        "src/slack-file-preview.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/csv-parser.js",
        "src/csv-drop-preview.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.zhihu.com/*"
      ],
      "js": [
        "src/zhihu-read-aloud.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/csv-viewer.html",
        "src/csv-viewer.js",
        "src/csv-parser.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "src/popup.html",
  "background": {
    "service_worker": "src/background.js"
  }
}