{
  "name": "sol-price-status-bar",
  "displayName": "SOL 实时价格",
  "description": "在 VS Code 右上角的副侧边栏常驻显示 Solana 实时价格，涨绿跌红，含 24h 涨跌 / 高低点 / 更新时间",
  "version": "2.0.0",
  "publisher": "walter",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhwei820/Convert-timestamp.git",
    "directory": "vs-code-plugin"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "solana",
    "sol",
    "crypto",
    "price",
    "行情"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "solPrice",
          "title": "实时价格",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "solPrice": [
        {
          "id": "solPrice.card",
          "name": "实时价格",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "solPrice.refresh",
          "when": "view == solPrice.card",
          "group": "navigation@1"
        },
        {
          "command": "solPrice.switchSymbol",
          "when": "view == solPrice.card",
          "group": "navigation@2"
        },
        {
          "command": "solPrice.showLog",
          "when": "view == solPrice.card",
          "group": "1_other@1"
        }
      ]
    },
    "commands": [
      {
        "command": "solPrice.show",
        "title": "显示价格卡片",
        "category": "实时价格"
      },
      {
        "command": "solPrice.refresh",
        "title": "立即刷新",
        "category": "实时价格",
        "icon": "$(sync)"
      },
      {
        "command": "solPrice.copyPrice",
        "title": "复制当前价格",
        "category": "实时价格"
      },
      {
        "command": "solPrice.switchSymbol",
        "title": "切换币种",
        "category": "实时价格",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "solPrice.showLog",
        "title": "查看日志",
        "category": "实时价格"
      }
    ],
    "configuration": {
      "title": "实时价格",
      "properties": {
        "solPrice.symbol": {
          "type": "string",
          "default": "SOL",
          "pattern": "^[A-Za-z0-9]{2,12}$",
          "patternErrorMessage": "只填币种代号本身，比如 SOL / BTC / ETH，不要带 USDT",
          "markdownDescription": "要显示的币种代号（对 USDT 计价）。填 `SOL`、`BTC`、`ETH` 之类，不要带 `USDT` 后缀。"
        },
        "solPrice.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "markdownDescription": "自动刷新间隔（秒）。低于 5 秒会被抬回 5 秒，避免被交易所限流。卡片不可见时会自动暂停刷新。"
        },
        "solPrice.colorize": {
          "type": "boolean",
          "default": true,
          "description": "是否按涨跌给价格上色（涨绿跌红）。关掉则用主题的默认前景色。"
        },
        "solPrice.invertColors": {
          "type": "boolean",
          "default": false,
          "description": "把配色换成 A 股习惯的「红涨绿跌」。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.3"
  }
}
